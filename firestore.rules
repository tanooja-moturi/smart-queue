rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the caller is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if caller has staff or admin role in their auth token claims or user document
    function isStaff() {
      return isAuthenticated() &&
        (request.auth.token.role in ['staff', 'admin'] ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'admin']);
    }

    // --- Users Collection ---
    // Users can read only their own profile.
    // Self-modification cannot escalate roles; all sensitive provisioning is handled via backend Admin SDK.
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create: if isOwner(userId) && request.resource.data.role == 'customer';
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // --- Queues Collection ---
    // Public can read queue details (needed for public customer join/display).
    // Creation, deletion, and updates must go through server-side APIs (Firebase Admin SDK),
    // or be strictly restricted to verified queue owners.
    match /queues/{queueId} {
      allow read: if true;
      allow create, update, delete: if isStaff() && isOwner(request.resource.data.userId);

      // --- Queue Entries Subcollection ---
      // Public can read entries for live tracking (status, token number, wait time).
      // Writing/updating entries directly from the client is DENIED to prevent token spoofing,
      // skipping the queue line, or unauthorized status changes.
      // All joining and status updates MUST flow through backend API routes with atomic transactions.
      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // --- Saved Queues Collection ---
    // Customers can read and manage their saved queues via the API (Firebase Admin SDK),
    // and authenticated users can access documents they own.
    match /savedQueues/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.resource.data.ownerUid == request.auth.uid);
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
